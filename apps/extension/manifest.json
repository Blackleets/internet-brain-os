{
  "manifest_version": 3,
  "name": "Efesto",
  "version": "0.1.0",
  "description": "Efesto for your browser: save pages as private evidence and send Goals to the Efesto running on your computer.",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Efesto",
    "default_popup": "src/popup-v2.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/page-context.js",
        "src/content-script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://efesto-five.vercel.app/*"
      ],
      "js": [
        "src/dashboard-discovery.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://127.0.0.1:3311/*",
        "http://localhost:3311/*"
      ],
      "js": [
        "src/dashboard-pair-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://efesto-five.vercel.app/*"
    ]
  }
}
